{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finternetlab.io/mcp/tools/check_transfer_eligibility/output.schema.json",
  "title": "check_transfer_eligibility output",
  "type": "object",
  "required": ["resultCode", "eligible"],
  "properties": {
    "resultCode": { "type": "string", "enum": ["OK", "SCOPE_EXCEEDED", "POLICY_FAILED", "CREDENTIAL_REQUIRED"] },
    "eligible": { "type": "boolean" },
    "preflightId": { "type": "string" },
    "scopeCheck": { "type": "object" },
    "credentialChecks": { "type": "array", "items": { "type": "object" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message", "detail"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "detail": { "type": "object" }
      }
    }
  }
}
