{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finternetlab.io/mcp/tools/present_credential_vp/output.schema.json",
  "title": "present_credential_vp output",
  "type": "object",
  "required": ["resultCode", "status"],
  "properties": {
    "resultCode": { "type": "string", "enum": ["OK", "CREDENTIAL_REQUIRED", "CREDENTIAL_EXPIRED", "CREDENTIAL_REVOKED"] },
    "presentationId": { "type": "string" },
    "status": { "type": "string" },
    "credentialType": { "type": "string" },
    "verificationResult": { "type": "string" },
    "rawClaimValuesExposed": { "type": "boolean", "const": false },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message", "detail"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "detail": { "type": "object" }
      }
    }
  }
}
